{
  "name": "chainsight-academy",
  "productName": "ChainSight Academy",
  "version": "1.0.0",
  "description": "Crypto Investigator Training — full interactive blockchain investigation course",
  "main": "main.js",
  "author": "ChainSight Academy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable nsis --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "academy.chainsight.investigator",
    "productName": "ChainSight Academy",
    "files": ["main.js", "preload.js", "app/**/*"],
    "directories": { "output": "dist" },
    "win": {
      "target": ["portable", "nsis"],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "portable": { "artifactName": "ChainSight-Academy-${version}-portable.exe" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ChainSight-Academy-Setup-${version}.exe"
    },
    "linux": { "target": "AppImage", "icon": "build/icon.png" }
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  }
}
