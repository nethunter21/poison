{
  "name": "poison-terminal",
  "productName": "Poison Terminal",
  "version": "2.0.0",
  "description": "Lightweight offline memecoin trading trainer: realistic pump.fun-style market simulation, rugs, red flags, TP/SL, keyboard trading and shareable PnL cards.",
  "main": "main.js",
  "author": "nethunter21",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.poison.terminal",
    "productName": "Poison Terminal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Poison Terminal",
      "artifactName": "PoisonTerminal-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PoisonTerminal-${version}-portable.${ext}"
    }
  }
}
